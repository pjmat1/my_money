    "react-bootstrap": "^2.10.2",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.55.0",
    "react-redux": "^9.1.0",
    "react-router-bootstrap": "^0.26.2",
    "react-router-dom": "^6.22.3",
    "react-select": "^5.8.0",
    "react-sticky-el": "^2.1.0",
    "redux": "^5.0.1",
